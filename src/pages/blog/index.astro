---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const site = "https://cognitsystem.com";

const posts = [
  {
    title: "Free B2B ordering software for wholesalers",
    dek: "The honest answer on what \"free\" gets you in B2B ordering — what to look for, what to avoid, and how to judge a system properly before you commit.",
    slug: "free-b2b-ordering-software-nz",
    tag: "Buying advice",
  },
  {
    title: "How to try an ERP before you buy",
    dek: "Almost nobody gives you a real trial — including us. What to insist on instead, and the one question that exposes a bad fit fastest.",
    slug: "erp-free-trial-nz",
    tag: "Buying advice",
  },
  {
    title: "How to take wholesale orders online",
    dek: "A practical, do-it-this-week guide to getting trade customers ordering online at no cost — catalogue, logins, pricing, go live — then grow into the full ERP.",
    slug: "take-wholesale-orders-online-free",
    tag: "How-to",
  },
  {
    title: "What is an all-in-one ERP with a built-in online store?",
    dek: "The concept explained — and why a store built into your ERP beats bolting a website onto separate systems.",
    slug: "all-in-one-erp-with-built-in-online-store",
    tag: "Guide",
  },
  {
    title: "The best ERP for wholesale distributors in New Zealand",
    dek: "A buyer's guide to what distributors actually need — stock, customer pricing, B2B ordering, rebates and Xero — and how to choose.",
    slug: "best-erp-for-wholesale-distributors-nz",
    tag: "Buyer's guide",
  },
  {
    title: "ERP with built-in e-commerce vs a website plus separate accounting",
    dek: "Two ways to run a product business compared — and the hidden costs and sync problems of the bolt-on approach.",
    slug: "erp-with-ecommerce-vs-website-plus-accounting",
    tag: "Comparison",
  },
  {
    title: "Do I still need Xero if I have an ERP?",
    dek: "Cognit has a real general ledger of its own and also sends your invoices and credit notes straight to Xero. Here's when each option makes sense.",
    slug: "do-i-still-need-xero-with-an-erp",
    tag: "Accounting",
  },
  {
    title: "How to stop losing money on supplier rebates and claim-backs",
    dek: "Why spreadsheets quietly cost distributors thousands a month — and how automated rebate tracking recovers it.",
    slug: "supplier-rebates-and-claim-backs-software",
    tag: "Rebates",
  },
  {
    title: "How to replace multiple disconnected business systems with one ERP",
    dek: "The patchwork problem, a sensible migration approach, and exactly what to consolidate first.",
    slug: "replace-multiple-business-systems-with-one-erp",
    tag: "Migration",
  },
  {
    title: "Inventory and stock control software for wholesalers",
    dek: "Why disconnected stock systems quietly cost distributors money — and what real-time inventory should actually look like.",
    slug: "inventory-stock-control-software-for-wholesalers",
    tag: "Inventory",
  },
  {
    title: "MYOB or an all-in-one ERP? What Australian wholesalers need to know",
    dek: "MYOB is solid at the books, but it wasn't built for B2B ordering, live stock or wholesale pricing. How to tell if it's still enough — and how Cognit fits either way.",
    slug: "myob-vs-all-in-one-erp-for-wholesalers",
    tag: "Accounting",
  },
  {
    title: "ERP for food and beverage distributors: what to look for",
    dek: "Short shelf life, tight margins and customers ordering at all hours. What an ERP actually needs to handle food and beverage distribution — and where generic software falls short.",
    slug: "erp-for-food-and-beverage-distributors",
    tag: "Food & beverage",
  },
  {
    title: "Landed cost software for importers and distributors",
    dek: "If you're pricing off the supplier invoice, you're pricing wrong. What freight, duty and exchange rate actually do to your unit cost — and how to stop losing margin to it.",
    slug: "landed-cost-software-for-importers",
    tag: "Importing",
  },
  {
    title: "Customer-specific pricing for wholesale distributors",
    dek: "Your best customers get a better price. If it only lives in a rep's head or a spreadsheet, you're one order away from getting it wrong — how customer pricing and price lists should actually work.",
    slug: "customer-specific-pricing-for-wholesalers",
    tag: "Pricing",
  },
  {
    title: "Credit limits and accounts receivable for wholesale distributors",
    dek: "Trade credit is normal — bad debt from ignoring credit limits isn't. How to enforce credit limits and trade terms automatically, on every order, without a rep having to be the bad guy.",
    slug: "credit-limits-and-accounts-receivable-for-wholesalers",
    tag: "Credit control",
  },
  {
    title: "Delivery routes and a driver app for wholesale distributors",
    dek: "If your run sheet is a printout and driver updates come through a group chat, here's what running delivery routes on the same system as your orders actually looks like.",
    slug: "delivery-routes-and-driver-app-for-wholesalers",
    tag: "Delivery",
  },
  {
    title: "Catch-weight pricing for meat and seafood distributors",
    dek: "A carton of lamb racks never weighs exactly what the label says. Why catch-weight products break ordinary ordering software — and what catch-weight pricing and invoicing should actually look like.",
    slug: "catch-weight-pricing-for-meat-and-seafood-distributors",
    tag: "Food & beverage",
  },
  {
    title: "Batch and lot traceability for food distributors",
    dek: "If a supplier recalls one batch tomorrow, could you name every customer who received it within the hour? What real batch and lot traceability requires — and why a spreadsheet isn't it.",
    slug: "batch-lot-traceability-food-distributors",
    tag: "Food & beverage",
  },
  {
    title: "Consignment stock for wholesale distributors",
    dek: "Stock sitting on a customer's shelf that you still own, invoiced only once it sells. Why consignment and sale-or-return arrangements break ordinary stock systems — and what tracking it properly should look like.",
    slug: "consignment-stock-for-wholesale-distributors",
    tag: "Inventory",
  },
  {
    title: "EDI order integration for wholesale suppliers",
    dek: "Big accounts increasingly want to trade electronically, on their terms. What EDI actually asks of a supplier — and how to connect it to your system instead of re-keying it by hand.",
    slug: "edi-integration-for-wholesale-suppliers",
    tag: "Integration",
  },
  {
    title: "A sales rep ordering app for wholesale distributors",
    dek: "If a rep's order doesn't hit stock or the customer's account until someone keys it in later, you're selling on yesterday's numbers. What a real rep ordering app should do.",
    slug: "sales-rep-ordering-app-for-wholesalers",
    tag: "Sales",
  },
  {
    title: "Unit of measure conversions for wholesale distributors",
    dek: "Buy by the pallet, hold by the case, sell by the carton or the each — on the same product, sometimes to the same customer. What breaks when software only tracks one unit.",
    slug: "unit-of-measure-conversions-for-wholesale-distributors",
    tag: "Inventory",
  },
  {
    title: "FEFO expiry-date stock rotation for food distributors",
    dek: "Nearest to the door isn't always closest to expiry. What first-expired-first-out picking actually requires — and why relying on pickers to remember it doesn't work at volume.",
    slug: "fefo-expiry-date-stock-rotation-food-distributors",
    tag: "Food & beverage",
  },
  {
    title: "Vendor-managed inventory (VMI) for wholesale distributors",
    dek: "A large account wants you to decide when they get restocked, not the other way round. What VMI actually asks of your stock and ordering system — and why a spreadsheet in the middle doesn't survive contact with it.",
    slug: "vendor-managed-inventory-for-wholesale-distributors",
    tag: "Inventory",
  },
  {
    title: "Returns and credit notes for wholesale distributors",
    dek: "A pallet comes back damaged, short-dated, or just wrong. What handling returns, credit notes and restocking properly requires — and why most distributors still run it on a docket and a phone call.",
    slug: "returns-and-credit-notes-for-wholesale-distributors",
    tag: "Accounting",
  },
  {
    title: "Backorder management for wholesale distributors",
    dek: "An order comes in for more than you've got. Ship part of it now, hold the rest, or hold the lot — what actually has to happen to stock, orders and invoicing so the promise doesn't get lost.",
    slug: "backorder-management-for-wholesale-distributors",
    tag: "Inventory",
  },
  {
    title: "Goods receipt discrepancies for wholesale distributors",
    dek: "A case short, two cartons extra, or a pallet that turned up damaged. What actually has to happen to a purchase order, your stock and what you owe the supplier when what lands doesn't match what you ordered.",
    slug: "goods-receipt-discrepancies-for-wholesale-distributors",
    tag: "Purchasing",
  },
  {
    title: "Pick-pack accuracy for wholesale distributors",
    dek: "Nine cartons instead of ten, or the right quantity of the wrong product. Why picking errors happen on a paper-and-memory warehouse floor, and what catches one before the truck leaves instead of after the customer calls.",
    slug: "pick-pack-accuracy-for-wholesale-distributors",
    tag: "Warehouse",
  },
  {
    title: "Case-pack and MOQ enforcement for wholesale distributors",
    dek: "A customer orders 7 when it only ships in cases of 12, or places an order too small to be worth the drop. Why letting the order through anyway costs more than saying no at the point it's placed.",
    slug: "case-pack-and-moq-enforcement-for-wholesale-distributors",
    tag: "Sales",
  },
  {
    title: "Aged receivables and customer statements for wholesale distributors",
    dek: "Knowing who owes you money is one thing. Chasing it off a debtor report that's already stale, then building a statement by hand when a customer asks for one, is another.",
    slug: "aged-receivables-and-customer-statements-for-wholesale-distributors",
    tag: "Accounting",
  },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${site}/blog/`,
  name: "Cognit Insights",
  description:
    "Insights on running a wholesale or distribution business on one connected ERP — built-in B2B e-commerce, inventory, accounting, supplier rebates and reporting.",
  url: `${site}/blog/`,
  isPartOf: { "@id": `${site}/#website` },
  hasPart: posts.map((p) => ({
    "@type": "Article",
    headline: p.title,
    description: p.dek,
    url: `${site}/blog/${p.slug}/`,
  })),
};
---

<Layout
  title="Insights — ERP, B2B E-commerce & Distribution | Cognit"
  description="Practical insights for NZ and Australian wholesalers, distributors and product businesses — all-in-one ERP, built-in B2B e-commerce, supplier rebates, inventory, accounting and how to run everything on one system."
  path="/blog"
  schema={collectionSchema}
>
  <Header />

  <main class="bg-cog-stone text-cog-slate">
    <!-- HERO (photographic) -->
    <section class="orbs relative isolate overflow-hidden">
      <img src="/images/warehouse-shelves.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-cog-ink/82"></div>
      <div class="dotgrid absolute inset-0 -z-10 opacity-40"></div>
      <div class="mx-auto max-w-3xl px-5 pt-20 pb-20 text-center sm:px-8 sm:pt-28 hero-rise">
        <span class="chip mx-auto border border-white/15 text-slate-200">Insights</span>
        <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
          Running your business on <span class="text-gradient-bright">one system.</span>
        </h1>
        <p class="mt-4 text-lg text-slate-300">
          Clear, practical thinking for wholesalers, distributors and product
          businesses — on B2B e-commerce, inventory, accounting, supplier rebates
          and what it really takes to run everything as one connected system.
        </p>
      </div>
    </section>

    <!-- POST GRID -->
    <section class="mx-auto max-w-6xl px-5 pb-20 pt-8 sm:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="card-hairline card-hover group flex flex-col rounded-3xl p-7">
            <span class="chip w-fit bg-cog-sky text-cog-blue-700">{p.tag}</span>
            <h2 class="mt-4 text-lg font-bold leading-snug text-cog-ink">{p.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-cog-slate">{p.dek}</p>
            <span class="mt-5 inline-block text-sm font-semibold text-cog-purple">Read →</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
