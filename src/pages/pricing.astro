---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// ─────────────────────────────────────────────────────────────────────────────
// NO PRICING, NO PLANS, NO FREE TRIAL ON THIS SITE. Owner decision, 2026-08-09.
// We are not ready to commit to public price points or packaged tiers, and we
// will not advertise a trial we don't run. This page does exactly two things:
// lists what the system genuinely does today, and lists what is still being
// built. Pricing is scoped per client and discussed in person.
//
// Everything in `has` below must exist in the product TODAY and be verified
// against the code. Anything else belongs in `roadmap`.
// Source of truth: cognit/docs/WHAT-COGNIT-ACTUALLY-HAS.md
// ─────────────────────────────────────────────────────────────────────────────

const has = [
  {
    icon: "🛒",
    t: "Sales & the online store",
    items: [
      "Branded B2B online store, white-labelled to your brand",
      "Customer log-in accounts — each customer sees their own catalogue and prices",
      "Order management and full order history",
      "Keyboard-driven order screen built for fast telesales",
      "Customer-specific and contract pricing, per customer or per group",
      "Credit limits and pay-on-account terms",
      "Quotes with live per-line margin guardrails, quote PDF, convert to an order",
      "Customer statements — aged, branded PDF, emailed to the customer",
      "Customer 360 — spend change, lapsed products, who to call",
      "Delivery routes, driver run-sheets and proof of delivery",
      "Keep your existing product and customer codes when you migrate",
    ],
  },
  {
    icon: "📦",
    t: "Inventory & warehouse",
    items: [
      "Stock on hand, movement ledger, adjustments and write-offs",
      "Bins and shelf locations",
      "Tablet stocktakes — scan to count, with variance review",
      "Reorder levels and a reorder report",
      "Units of measure — a base stock unit plus alternate pack sizes",
      "Pick sheets sorted by bin walk path, printable",
      "Branch transfers, multi-branch and multi-warehouse",
    ],
  },
  {
    icon: "🧾",
    t: "Purchasing & accounts payable",
    items: [
      "Purchase orders, with PO PDFs emailed to suppliers",
      "Goods receipting, full and short",
      "Supplier records and spend",
      "Supplier bills — record what you owe and mark them paid",
      "Aged payables and supplier statements",
      "Supplier credits and debit notes, posted to the ledger",
    ],
  },
  {
    icon: "📊",
    t: "Money & accounting",
    items: [
      "Invoicing and sales credit notes",
      "Aged receivables",
      "A real general ledger — chart of accounts, journals, trial balance, balance sheet, P&L",
      "Automatic GL posting as you trade",
      "GST summary",
      "Supplier rebates & claim-backs — per-sale claim-backs, buy-N-get-M bonus stock, volume tiers, auto-accrued from sales and receipts, with a monthly claim report and claim batches",
    ],
  },
  {
    icon: "📈",
    t: "Reporting",
    items: [
      "30 reports, all downloadable to Excel",
      "Sales by customer, product, route, category and month",
      "Gross profit by customer and by product",
      "Stock valuation and stock movement ledger",
      "P&L summary and P&L by month",
      "Aged receivables, aged payables and GST summary",
      "Invoice, credit note and goods-receipt registers",
      "Customer activity and lapsed-customer reporting",
    ],
  },
  {
    icon: "🔐",
    t: "Platform",
    items: [
      "Your own private server and your own database — not shared",
      "Automatic daily backups, plus one-click backup download and restore",
      "Per-user permissions — control exactly what each staff member can see and do",
      "API access — your own key and a read-only API to pull your data into other systems",
      "CSV import and export of products, customers and orders",
      "Guided setup wizard — company details, staff, product and customer import, go live",
      "In-app help on every page",
    ],
  },
  {
    icon: "🔗",
    t: "Accounting connection",
    items: [
      "Xero connects in about 30 seconds and is included",
      "Invoices, credit notes, customers and products are sent across automatically, with a status badge and auto-retry",
      "This connection runs one way today — Cognit feeds your accounting system; nothing is pulled back",
      "Running MYOB, Accredo, Attaché or something else? We build that connection as part of your project",
    ],
  },
];

// STILL BEING BUILT. Never move an item from here into the `has` list above
// until a real client is genuinely using it.
const roadmap = [
  { t: "Buyer & driver mobile apps", d: "Native iOS and Android — reorder on the phone, and run-sheets with photo proof of delivery for drivers." },
  { t: "AI supplier-invoice reading", d: "A supplier invoice arrives by email, gets matched to the purchase order and books the stock in." },
  { t: "Two-way accounting sync", d: "Today Cognit sends invoices and credit notes out. Pulling payments and reconciliation back the other way is next." },
  { t: "More accounting connections", d: "Beyond Xero — MYOB and others, driven by what our clients actually run." },
  { t: "Pay by card online", d: "Card payment on the store." },
];

// Things people in this industry ask for that Cognit genuinely does NOT do.
// Being straight about these up front costs us nothing and saves everyone a
// wasted sales cycle.
const notYet = [
  "Landed-cost apportionment across freight and duty",
  "Multi-currency purchasing",
  "Catch-weight",
  "Lot and expiry tracking",
  "Consignment stock",
  "EDI",
];

const faqs = [
  {
    q: "What does Cognit cost?",
    a: "Please contact us for pricing. There's no price list, because there's no one-size package — what you pay depends on what you actually need running, how much of your data we migrate, and whether we're building anything specific for your business. Tell us how you operate and we'll put a real number in front of you rather than a starting-from figure that changes later.",
  },
  {
    q: "Why don't you publish prices?",
    a: "Because we'd rather quote you honestly than advertise a number we'd have to renegotiate once we understand your business. Distribution businesses vary enormously — a two-branch importer and a single-site foodservice wholesaler need different things. We'll be direct about cost early in the conversation; you won't have to sit through three meetings to find out.",
  },
  {
    q: "What if Cognit doesn't do something I need?",
    a: "Tell us, and we'll be straight about whether it exists, whether it's on the roadmap, or whether it's a build. Cognit is made and maintained by Zeabyte, a New Zealand software company — building the missing piece into your system is our actual business, not an exception we make reluctantly.",
  },
  {
    q: "How do I know what's real and what's coming?",
    a: "That's what this page is for. Everything under \"What the system does today\" is running in the product right now. Everything under \"What we're building\" genuinely isn't finished yet, and we've listed the things we don't do at all. We'd rather lose a deal on the truth than win one on a demo of something that doesn't exist.",
  },
  {
    q: "Is my data mine?",
    a: "Always. Your customers, products, orders, invoices and accounts are yours. You can export your records to Excel or PDF whenever you like, and if you ever leave, you take your data with you. Every client runs on their own private server.",
  },
  {
    q: "How long does it take to get running?",
    a: "Weeks, not the year an enterprise ERP rollout takes. We load your products and customers, set the system up for you, walk your team through it and stay close while you go live. The exact timeline depends on how much data is coming across and whether anything is being built for you.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="What Cognit Does — and What We're Still Building | Cognit NZ"
  description="An honest list of what the Cognit ERP does today — sales, the built-in B2B online store, inventory, purchasing, invoicing, accounting, rebates and 30 reports — plus what's still being built and what it doesn't do. No price list: please contact us for pricing, scoped to what your business actually needs. Built in New Zealand."
  path="/pricing"
  schema={faqSchema}
>
  <Header />

  <main class="bg-cog-stone text-cog-slate">
    <!-- HERO -->
    <section class="orbs relative isolate overflow-hidden">
      <img src="/images/hero-cranes-night.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-cog-ink/82"></div>
      <div class="dotgrid absolute inset-0 -z-10 opacity-40"></div>
      <div class="mx-auto max-w-5xl px-5 pb-20 pt-20 text-center sm:px-8 sm:pt-28 hero-rise">
        <span class="chip mx-auto border border-white/15 text-slate-200">
          <span class="h-2 w-2 rounded-full bg-cog-teal"></span> What's real · what's coming
        </span>
        <h1 class="mx-auto mt-7 max-w-4xl text-[2.6rem] font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
          Everything the system does.
          <span class="text-gradient-bright"> Nothing it doesn't.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
          Below is what Cognit genuinely does today, what we're still building, and
          what it doesn't do at all. There's no price list — what you pay depends on
          what you actually need running, so
          <strong class="font-semibold text-white">please contact us for pricing</strong>.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href="/contact" class="btn-grad">Book a demo</a>
          <a href="#roadmap" class="btn-ghost !border-white/30 !text-white">See what's coming →</a>
        </div>
      </div>
    </section>

    <!-- WHAT IT DOES TODAY -->
    <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <div class="mb-12 max-w-2xl">
        <span class="chip bg-cog-sky text-cog-blue-700">Available now</span>
        <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-cog-ink sm:text-4xl">
          What the system does today
        </h2>
        <p class="mt-4 text-lg text-cog-slate">
          Every line below is running in the product right now. If it isn't on this
          list, we won't tell you it's there.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        {has.map((g) => (
          <div class="card-hairline rounded-3xl bg-white p-7 sm:p-8">
            <div class="flex items-center gap-3">
              <span class="text-2xl">{g.icon}</span>
              <h3 class="text-lg font-extrabold tracking-tight text-cog-ink">{g.t}</h3>
            </div>
            <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-cog-slate">
              {g.items.map((i) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 flex-none font-bold text-cog-teal">✓</span>{i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- BUILDING NEXT -->
    <section id="roadmap" class="mx-auto max-w-5xl px-5 pb-8 sm:px-8">
      <div class="card-hairline rounded-3xl bg-white p-8 sm:p-10">
        <div class="flex flex-wrap items-center gap-3">
          <span class="chip bg-cog-sky text-cog-blue-700">Building next</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            In development — not available today
          </span>
        </div>
        <h2 class="mt-5 text-2xl font-extrabold tracking-tight text-cog-ink sm:text-3xl">
          What we're working on — and what we won't pretend we have yet
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-cog-slate">
          Plenty of software gets sold on a demo of something that isn't finished.
          We'd rather show you the line. Everything above works today. Everything
          here is genuinely still being built.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {roadmap.map((r) => (
            <li class="rounded-2xl border border-black/5 bg-cog-stone p-5">
              <div class="flex items-start gap-3">
                <span class="mt-1 flex-none text-slate-400">◷</span>
                <div>
                  <div class="text-sm font-bold text-cog-ink">{r.t}</div>
                  <p class="mt-1.5 text-sm leading-relaxed text-cog-slate">{r.d}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8 border-t border-black/5 pt-7">
          <h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-400">
            And things we don't do at all
          </h3>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-cog-slate">
            Common asks in this industry that aren't in Cognit. If one of these is
            how your business runs, say so early — we'll tell you honestly whether
            it's a build or a bad fit.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {notYet.map((n) => (
              <span class="rounded-full border border-black/5 bg-cog-stone px-3.5 py-1.5 text-xs font-medium text-slate-500">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- HOW PRICING WORKS -->
    <section class="px-4 py-16 sm:px-8">
      <div class="orbs relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-cog-ink px-6 py-16 text-center text-white sm:px-12">
        <div class="dotgrid absolute inset-0 opacity-50"></div>
        <div class="relative">
          <span class="chip mx-auto border border-white/15 text-slate-200">How pricing works</span>
          <h2 class="mx-auto mt-6 max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            Contact us for pricing — <span class="text-gradient-bright">we quote on what you need.</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">
            There's no price list here, and that's deliberate. A two-branch importer
            and a single-site foodservice wholesaler need different things, and a
            starting-from number that changes once we understand your business helps
            nobody. Tell us how you operate — what you sell, how orders reach you,
            what you're running now — and we'll put a real figure in front of you
            early, not after three meetings.
          </p>
          <div class="mt-10 grid gap-3 text-left sm:grid-cols-3">
            {[
              { n: "1", t: "Tell us how you operate", b: "A conversation, not a scripted demo. What you sell, how orders arrive, what's broken." },
              { n: "2", t: "We show you the real system", b: "Loaded with data that looks like yours, so you can see the parts that matter to you." },
              { n: "3", t: "You get a real number", b: "Scoped to what you'll actually use, including anything we'd build for you." },
            ].map((s) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
                <div class="brand-gradient flex h-8 w-8 items-center justify-center rounded-lg text-sm font-extrabold text-white">{s.n}</div>
                <div class="mt-4 text-sm font-bold text-white">{s.t}</div>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">{s.b}</p>
              </div>
            ))}
          </div>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="/contact" class="btn-grad">Talk to us</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 pb-24 sm:px-8">
      <h2 class="text-center text-3xl font-extrabold tracking-tight text-cog-ink sm:text-4xl">Questions, answered straight</h2>
      <div class="mt-10 space-y-3">
        {faqs.map((f) => (
          <details class="card-hairline group rounded-2xl p-6 open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-bold text-cog-ink">
              {f.q}
              <span class="ml-4 text-cog-purple transition group-open:rotate-45">＋</span>
            </summary>
            <p class="mt-3 leading-relaxed text-cog-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
