---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// PRICING IS A SINGLE SOURCE OF TRUTH. These numbers must stay identical to
// PLAN_META in the Cognit app (api/helpers/moduleAccess.helper.js) and to the
// plan block on zeabyte.co.nz/cognit. Owner-decided 2026-08-09.
//
// RULE: only list a feature a client could actually use on the day they sign up.
// Anything still being built belongs in `roadmap` below — never in a plan's
// tick-list. (AI invoice reading is built but has never been switched on for a
// real client, so it lives on the roadmap, not in Premium.)
const plans = [
  {
    name: "Free trial",
    slug: "trial",
    price: "0",
    unit: "for 14 days",
    tagline: "Try the whole system — every module unlocked — free for 14 days.",
    cta: "Start free trial",
    href: "/start?plan=trial",
    popular: false,
    features: [
      "Everything unlocked for 14 days",
      "The full ERP + built-in online store",
      "Loaded with your data, set up for you",
      "No credit card to start",
      "Choose a plan when you're ready",
    ],
    footnote: "When you're ready, pick the plan that fits — Standard, Premium or Enterprise.",
  },
  {
    name: "Standard",
    slug: "standard",
    price: "750",
    unit: "NZD / month",
    tagline: "A B2B online store with your products and customers — take orders online.",
    cta: "Start free trial",
    href: "/start?plan=standard",
    popular: false,
    features: [
      "Branded B2B online store",
      "Your product catalogue",
      "Your customer accounts",
      "Online order management & history",
      "Lost-sale capture",
      "Core sales reports",
      "Multiple staff logins",
      "NZ-based support",
    ],
    footnote: "Inventory, purchasing, invoicing and accounting are on Premium.",
  },
  {
    name: "Premium",
    slug: "premium",
    price: "1,500",
    unit: "NZD / month",
    tagline: "The complete ERP — run your whole operation in one system.",
    cta: "Start free trial",
    href: "/start?plan=premium",
    popular: true,
    features: [
      "Everything in Standard, plus:",
      "Inventory, stock control & stocktakes",
      "Purchasing, goods receipting & supplier bills",
      "Invoicing, credit notes & customer statements",
      "Customer-specific & contract pricing",
      "Quotes with margin guardrails",
      "Pick sheets & proof of delivery",
      "Supplier rebates & claim-backs",
      "Accounting & general ledger",
      "Full reporting suite — 25 reports",
      "Sends invoices & credit notes to Xero",
    ],
  },
  {
    name: "Enterprise",
    slug: "enterprise",
    price: "Let's talk",
    custom: true,
    unit: "quoted per project",
    tagline: "For multi-branch operations that need the system shaped around them.",
    cta: "Talk to our team",
    href: "/contact",
    popular: false,
    features: [
      "Everything in Premium, plus:",
      "Multi-branch & multi-warehouse",
      "Per-user permissions",
      "API access & data export",
      "One-click backup & restore",
      "Custom modules built for your business",
      "Priority support, direct to the team who built it",
    ],
    footnote: "Priced on what you need built — not a fixed monthly bundle.",
  },
];

// 's' = Standard, 'p' = Premium, 'e' = Enterprise. The 14-day free trial
// unlocks every row below, so it doesn't need its own column.
// Every row here maps to a module that exists and works today — see
// MODULE_TIER in the app. Nothing aspirational belongs in this table.
const compare = [
  { f: "Branded B2B online store", s: true, p: true, e: true },
  { f: "Online order management & history", s: true, p: true, e: true },
  { f: "Product catalogue", s: "Unlimited", p: "Unlimited", e: "Unlimited" },
  { f: "Customer accounts", s: "Unlimited", p: "Unlimited", e: "Unlimited" },
  { f: "Staff logins", s: "Multiple", p: "Multiple", e: "Multiple" },
  { f: "Lost-sale capture (missed opportunities)", s: true, p: true, e: true },
  { f: "Reporting", s: "Core sales", p: "Full suite", e: "Full suite" },
  { f: "Inventory, stock control & stocktakes", s: false, p: true, e: true },
  { f: "Purchasing, goods receipts & supplier bills", s: false, p: true, e: true },
  { f: "Invoicing, credit notes & customer statements", s: false, p: true, e: true },
  { f: "Customer-specific & contract pricing", s: false, p: true, e: true },
  { f: "Quotes with margin guardrails", s: false, p: true, e: true },
  { f: "Pick sheets & proof of delivery", s: false, p: true, e: true },
  { f: "Supplier rebates & claim-backs", s: false, p: true, e: true },
  { f: "Accounting & general ledger", s: false, p: true, e: true },
  { f: "Aged receivables, aged payables & GST reports", s: false, p: true, e: true },
  { f: "Sends invoices & credit notes to Xero", s: false, p: true, e: true },
  { f: "Customer 360 / rep insights", s: false, p: true, e: true },
  { f: "Multi-branch & multi-warehouse", s: false, p: false, e: true },
  { f: "Per-user permissions", s: false, p: false, e: true },
  { f: "API access & data export", s: false, p: false, e: true },
  { f: "One-click backup & restore", s: false, p: false, e: true },
  { f: "Custom modules built for you", s: false, p: false, e: true },
  { f: "Support", s: "NZ-based", p: "Priority", e: "Priority + direct" },
];

// IN DEVELOPMENT — deliberately kept OUT of every plan above. Never move an
// item from here into a plan tick-list until a real client is using it.
const roadmap = [
  { t: "Buyer & driver mobile apps", d: "Native iOS & Android — reorder on the phone, and run-sheets with photo proof of delivery for drivers." },
  { t: "AI supplier-invoice reading", d: "A supplier invoice arrives by email, gets matched to the purchase order and books the stock in." },
  { t: "Two-way Xero sync", d: "Today Cognit sends invoices and credit notes to Xero. Pulling payments back the other way is next." },
  { t: "More accounting integrations", d: "Beyond Xero — MYOB and others, driven by what our clients actually use." },
  { t: "Pay by card online", d: "Card payment on the store and self-service subscription billing." },
];

const faqs = [
  {
    q: "How does the free trial work?",
    a: "You start with a 14-day free trial of the whole system — every module unlocked, loaded with data and set up for you, no credit card. At the end of the 14 days you pick the plan that fits: Standard for a B2B online store with your products and customers, Premium for the full ERP, or Enterprise if you need multi-branch, per-user permissions or modules built specifically for your business.",
  },
  {
    q: "What happens after the 14 days?",
    a: "Near the end of your trial we'll check in. If Cognit is working for you, you continue on your chosen plan; if it isn't the right fit, you simply stop — there's no lock-in and nothing to cancel if you never started paying.",
  },
  {
    q: "Do I need a credit card?",
    a: "No. You can start your 14-day free trial without entering any card details. We set Cognit up for you and email your login — you only arrange payment if you decide to continue on a paid plan after the trial.",
  },
  {
    q: "Can I change plans?",
    a: "Any time. Start on Standard for a B2B online store with your products and customers, and step up to Premium for the full ERP — inventory, purchasing, invoicing, customer pricing, quotes, pick sheets, rebates, accounting and the full reporting suite. Those modules are already built into Cognit, so moving up is a setting we switch on rather than another project. You can move back down too. No lock-in, cancel anytime.",
  },
  {
    q: "What is Cognit still working on?",
    a: "We'd rather tell you up front than oversell. Being built right now: native buyer and driver mobile apps; AI reading of supplier invoices; a two-way Xero sync (today Cognit sends invoices and credit notes to Xero, it doesn't pull back); integrations with accounting systems beyond Xero; and online card payment. None of these are included in a plan today — when they ship, they're included free for clients on the plan they land in. If one of them is critical to you now, talk to us: building it with you is exactly what Zeabyte does.",
  },
  {
    q: "What if Cognit doesn't do something I need?",
    a: "Tell us. Cognit is built and maintained by Zeabyte, a New Zealand software company — we build the missing piece into your system rather than telling you to change how you work. That's what the Enterprise plan is: your own modules, quoted on what you actually need.",
  },
  {
    q: "Is my data mine?",
    a: "Always. Your customers, products, orders, invoices and accounts are yours. You can export your records to Excel or PDF whenever you like, and if you ever leave, you take your data with you. Every client runs on their own private server.",
  },
];

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Cognit ERP",
  description:
    "Cognit is an all-in-one cloud ERP with a built-in B2B e-commerce online store. Try the whole system free for 14 days — sales, inventory, purchasing, accounting, invoicing, rebates and reporting in one system.",
  brand: { "@type": "Brand", name: "Cognit" },
  offers: [
    {
      "@type": "Offer",
      name: "Free trial",
      price: "0",
      priceCurrency: "NZD",
      description: "A 14-day free trial of the entire system — every module unlocked, no credit card. After 14 days, choose Standard, Premium or Enterprise to continue.",
      availability: "https://schema.org/InStock",
      url: "https://cognitsystem.com/pricing/",
    },
    {
      "@type": "Offer",
      name: "Standard",
      price: "750",
      priceCurrency: "NZD",
      description: "Per month, after a 14-day free trial. A branded B2B online store with your products and customers — online order management & history, lost-sale capture, core sales reports, multiple staff logins and NZ-based support. Inventory, purchasing, invoicing and accounting are on Premium.",
      availability: "https://schema.org/InStock",
      url: "https://cognitsystem.com/pricing/",
    },
    {
      "@type": "Offer",
      name: "Premium",
      price: "1500",
      priceCurrency: "NZD",
      description: "Per month, after a 14-day free trial. Everything in Standard plus inventory and stocktakes, purchasing and supplier bills, invoicing, credit notes and customer statements, customer-specific pricing, quotes, pick sheets, supplier rebates and claim-backs, accounting and general ledger, the full 25-report suite, and automatic sending of invoices and credit notes to Xero.",
      availability: "https://schema.org/InStock",
      url: "https://cognitsystem.com/pricing/",
    },
    {
      "@type": "Offer",
      name: "Enterprise",
      priceCurrency: "NZD",
      description: "Quoted per project. Everything in Premium plus multi-branch and multi-warehouse, per-user permissions, API access and data export, one-click backup and restore, and custom modules built for your business.",
      availability: "https://schema.org/InStock",
      url: "https://cognitsystem.com/contact/",
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="Cognit Pricing — 14-Day Free Trial, then Standard, Premium & Enterprise"
  description="Cognit pricing: a 14-day free trial of the whole system, then Standard (NZD $750/mo) for a B2B online store or Premium (NZD $1,500/mo) for the full ERP. Enterprise is quoted per project. No credit card, no lock-in. Setup, data migration and training included."
  path="/pricing"
  schema={[offerSchema, faqSchema]}
>
  <Header />

  <main class="bg-cog-stone text-cog-slate">
    <!-- HERO (photographic) -->
    <section class="orbs relative isolate overflow-hidden">
      <img src="/images/hero-cranes-night.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-cog-ink/82"></div>
      <div class="dotgrid absolute inset-0 -z-10 opacity-40"></div>
      <div class="mx-auto max-w-5xl px-5 pb-20 pt-20 text-center sm:px-8 sm:pt-28 hero-rise">
        <span class="chip mx-auto border border-white/15 text-slate-200">
          <span class="h-2 w-2 rounded-full bg-cog-teal"></span> Start free · upgrade when you're ready
        </span>
        <h1 class="mx-auto mt-7 max-w-4xl text-[2.6rem] font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
          Start free. Grow into
          <span class="text-gradient-bright"> the whole system.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 sm:text-xl">
          Try the whole system free for 14 days — no credit card. We set it up for
          you and email your login. Then it's $750/month for a B2B online store, or
          $1,500/month for the full ERP.
        </p>
      </div>
    </section>

    <!-- 14-DAY TRIAL BANNER -->
    <section class="mx-auto -mt-10 max-w-5xl px-5 sm:px-8">
      <div class="card-grad relative z-10 flex flex-col items-center justify-between gap-4 rounded-2xl px-6 py-5 text-center shadow-xl shadow-cog-purple/15 sm:flex-row sm:text-left">
        <p class="text-cog-ink">
          <strong class="font-extrabold">Try Standard or Premium free for 14 days</strong>
          — no credit card. We set it up for you and email your login.
        </p>
        <a href="/start?plan=standard" class="btn-grad !px-6 !py-3 text-sm">Start 14-day free trial →</a>
      </div>
    </section>

    <!-- PLAN CARDS -->
    <section class="mx-auto max-w-6xl px-5 pb-12 pt-16 sm:px-8">
      <div class="grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((plan) => (
          <div class={"card-hover relative flex flex-col rounded-3xl p-8 " + (plan.popular ? "card-grad shadow-xl shadow-cog-purple/15 lg:-mt-4 lg:pb-10" : "card-hairline")}>
            {plan.popular && (
              <span class="brand-gradient absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-cog-purple/30">
                Most popular
              </span>
            )}
            <h2 class="text-xl font-extrabold tracking-tight text-cog-ink">{plan.name}</h2>
            <p class="mt-2 min-h-[3.5rem] text-sm leading-relaxed text-cog-slate">{plan.tagline}</p>
            <div class="mt-5 flex items-end gap-1.5">
              {plan.custom ? (
                <span class="text-4xl font-extrabold tracking-tight text-cog-ink">{plan.price}</span>
              ) : (
                <span class="text-5xl font-extrabold tracking-tight text-cog-ink">${plan.price}</span>
              )}
              <span class="mb-1.5 text-sm font-medium text-slate-500">{plan.unit}</span>
            </div>
            {plan.trial && (
              <p class="mt-2 text-sm font-semibold text-cog-teal-600">{plan.trial}</p>
            )}
            <a href={plan.href} class={"mt-6 " + (plan.popular ? "btn-grad" : "btn-ghost")}>
              {plan.cta}
            </a>
            <ul class="mt-7 space-y-3 text-sm text-cog-slate">
              {plan.features.map((f, i) => (
                <li class={"flex gap-3 " + (i === 0 && f.includes("Everything in") ? "font-semibold text-cog-ink" : "")}>
                  <span class="mt-0.5 flex-none text-cog-teal">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            {plan.footnote && (
              <p class="mt-6 border-t border-black/5 pt-4 text-xs leading-relaxed text-slate-400">{plan.footnote}</p>
            )}
          </div>
        ))}
      </div>

      <p class="mt-10 text-center text-sm font-medium text-slate-500">
        No lock-in. Cancel anytime. Setup, data migration &amp; training included on paid plans.
      </p>
    </section>

    <!-- COMPARE TABLE -->
    <section class="mx-auto max-w-5xl px-5 py-24 sm:px-8">
      <div class="mb-12 max-w-2xl">
        <span class="chip bg-cog-sky text-cog-blue-700">Compare plans</span>
        <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-cog-ink sm:text-4xl">What's in each plan</h2>
        <p class="mt-4 text-lg text-cog-slate">
          Start with the online store, then switch on inventory, invoicing and accounting as you
          grow. Every row below works in Cognit today — the 14-day free trial unlocks all of it.
        </p>
      </div>

      <div class="card-hairline overflow-x-auto rounded-3xl">
        <div class="min-w-[38rem]">
          <div class="grid grid-cols-[1.9fr_0.8fr_0.8fr_0.9fr] bg-cog-ink text-white">
            <div class="px-4 py-4 text-sm font-bold sm:px-7">Feature</div>
            <div class="px-2 py-4 text-center text-sm font-bold text-slate-200">Standard</div>
            <div class="px-2 py-4 text-center text-sm font-bold text-cog-teal">Premium</div>
            <div class="px-2 py-4 text-center text-sm font-bold text-slate-200">Enterprise</div>
          </div>
          {compare.map((row, i) => (
            <div class={"grid grid-cols-[1.9fr_0.8fr_0.8fr_0.9fr] " + (i % 2 === 0 ? "bg-white" : "bg-cog-stone")}>
              <div class="px-4 py-4 text-sm font-medium text-cog-ink sm:px-7">{row.f}</div>
              <div class="px-2 py-4 text-center text-sm">
                {row.s === true ? <span class="font-bold text-cog-teal">✓</span>
                  : row.s === false ? <span class="text-slate-300">—</span>
                  : <span class="text-xs font-medium text-cog-slate">{row.s}</span>}
              </div>
              <div class="px-2 py-4 text-center text-sm">
                {row.p === true ? <span class="font-bold text-cog-teal">✓</span>
                  : row.p === false ? <span class="text-slate-300">—</span>
                  : <span class="text-xs font-medium text-cog-slate">{row.p}</span>}
              </div>
              <div class="px-2 py-4 text-center text-sm">
                {row.e === true ? <span class="font-bold text-cog-teal">✓</span>
                  : row.e === false ? <span class="text-slate-300">—</span>
                  : <span class="text-xs font-medium text-cog-slate">{row.e}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-ghost">Book a demo</a>
        <a href="/start?plan=standard" class="btn-grad">Start 14-day free trial →</a>
      </div>
    </section>

    <!-- BUILDING NEXT (roadmap — deliberately outside every plan) -->
    <section class="mx-auto max-w-5xl px-5 pb-8 sm:px-8">
      <div class="card-hairline rounded-3xl bg-white p-8 sm:p-10">
        <div class="flex flex-wrap items-center gap-3">
          <span class="chip bg-cog-sky text-cog-blue-700">Building next</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
            In development — not included in any plan today
          </span>
        </div>
        <h2 class="mt-5 text-2xl font-extrabold tracking-tight text-cog-ink sm:text-3xl">
          What we're working on — and what we won't pretend we have yet
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-cog-slate">
          Plenty of software gets sold on a demo of something that isn't finished. We'd rather
          show you the line. Everything in the plans above works today. Everything below is
          genuinely still being built.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {roadmap.map((r) => (
            <li class="rounded-2xl border border-black/5 bg-cog-stone p-5">
              <div class="flex items-start gap-3">
                <span class="mt-1 flex-none text-slate-400">◷</span>
                <div>
                  <div class="text-sm font-bold text-cog-ink">{r.t}</div>
                  <p class="mt-1.5 text-sm leading-relaxed text-cog-slate">{r.d}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8 border-t border-black/5 pt-6 text-sm leading-relaxed text-cog-slate">
          <strong class="font-bold text-cog-ink">When these ship, they're included free</strong> for
          clients on the plan they land in — no upgrade fee, no new project. And if one of them
          is critical to you right now, <a href="/contact" class="font-semibold text-cog-blue-700 underline decoration-cog-blue-700/30 underline-offset-2">talk to us</a> —
          building it with you is exactly what Zeabyte does.
        </p>
      </div>
    </section>

    <!-- VALUE BAND -->
    <section class="px-4 py-10 sm:px-8">
      <div class="orbs relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-cog-ink px-6 py-16 text-center text-white sm:px-12">
        <div class="dotgrid absolute inset-0 opacity-50"></div>
        <div class="relative">
          <h2 class="mx-auto max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            One subscription replaces a <span class="text-gradient-bright">shelf full of tools.</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">
            Think about what you pay today for a website, an ordering plugin, an inventory
            tool, accounting software, a reporting add-on — plus the time lost re-keying
            between them. Cognit is one price for all of it, working as a single system.
          </p>
          <div class="mt-10 grid gap-3 sm:grid-cols-4">
            {[
              { t: "Online store", e: "🛒" },
              { t: "Inventory & purchasing", e: "📦" },
              { t: "Accounting & ledger", e: "📊" },
              { t: "Reporting & insights", e: "📈" },
            ].map((x) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur">
                <div class="text-2xl">{x.e}</div>
                <div class="mt-2 text-sm font-semibold text-white">{x.t}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-5 py-24 sm:px-8">
      <h2 class="text-center text-3xl font-extrabold tracking-tight text-cog-ink sm:text-4xl">Pricing questions, answered</h2>
      <div class="mt-10 space-y-3">
        {faqs.map((f) => (
          <details class="card-hairline group rounded-2xl p-6 open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-bold text-cog-ink">
              {f.q}
              <span class="ml-4 text-cog-purple transition group-open:rotate-45">＋</span>
            </summary>
            <p class="mt-3 leading-relaxed text-cog-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
